<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="turbo-cache-control" content="no-cache">
  <meta name="csp-nonce" content="<%= @admin_csp_nonce %>">
  <title><%= RailsAiAdmin.configuration.title %></title>
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "rails_ai_admin", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "rails_ai_admin", type: "module", "data-turbo-track": "reload", defer: true, preload_links_header: false %>
</head>
<body class="raa">
  <a class="raa-skip" href="#raa-main">Skip to content</a>
  <header class="raa-header"><%= link_to RailsAiAdmin.configuration.title, root_path %><span>Development preview</span></header>
  <div class="raa-shell">
    <nav aria-label="Admin resources">
      <div class="raa-nav-primary">
        <%= link_to "Overview", root_path, aria: { current: (controller_path == "rails_ai_admin/dashboard" ? "page" : nil) } %>
        <% if assistant_available? %><%= link_to "Assistant", assistant_path, aria: { current: (controller_path == "rails_ai_admin/assistant" ? "location" : nil) } %><% end %>
        <% if collection_jobs_available? %><%= link_to "Collection jobs", collection_jobs_path, aria: { current: (controller_path == "rails_ai_admin/collection_jobs" ? "location" : nil) } %><% end %>
      </div>
      <%= render "rails_ai_admin/shared/navigation", groups: resource_navigation %>
    </nav>
    <main id="raa-main" tabindex="-1">
      <% if return_state_discarded? %><p class="raa-notice" role="status">Some list settings are no longer available. Return links use the current permitted list.</p><% end %>
      <% flash.each do |_, message| %><p class="raa-notice" role="status"><%= message %></p><% end %>
      <%= yield %>
    </main>
  </div>
</body>
</html>
