<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="turbo-cache-control" content="no-cache">
  <%# Turbo 8 prefetches links on hover. Admin form pages prepare an intent on GET,
      so a prefetch would write a row per hover (RAA-005); keep navigation explicit. %>
  <meta name="turbo-prefetch" content="false">
  <meta name="csp-nonce" content="<%= @admin_csp_nonce %>">
  <%# "Edit ORD-0001 · Orders · Administration" (RAA-024). Views provide :raa_title. %>
  <title><%= admin_page_title %></title>
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "rails_ai_admin", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "rails_ai_admin", type: "module", "data-turbo-track": "reload", defer: true, preload_links_header: false %>
</head>
<body class="raa" data-raa-messages="<%= t("rails_ai_admin.script").to_json %>">
  <a class="raa-skip" href="#raa-main"><%= t("rails_ai_admin.layout.skip") %></a>
  <header class="raa-header"><%= link_to RailsAiAdmin.configuration.title, root_path %>
    <% if @context && searchable_resources.any? %>
      <%= form_with url: global_search_path, method: :get, local: true, class: "raa-global-search", html: { role: "search", aria: { label: t("rails_ai_admin.search.label") } } do |form| %>
        <%= form.label :q, t("rails_ai_admin.search.label"), class: "raa-visually-hidden", for: "raa-global-search" %>
        <%= form.search_field :q, id: "raa-global-search", value: (controller_path == "rails_ai_admin/search" ? @query : nil), maxlength: 200, placeholder: t("rails_ai_admin.search.placeholder") %>
      <% end %>
    <% end %>
    <div class="raa-header-meta">
      <% if RailsAiAdmin.configuration.environment_label %><span class="raa-environment"><%= RailsAiAdmin.configuration.environment_label %></span><% end %>
      <%= render "rails_ai_admin/shared/session" %>
    </div>
  </header>
  <div class="raa-shell">
    <nav aria-label="<%= t("rails_ai_admin.layout.resources_nav") %>">
      <div class="raa-nav-primary">
        <%= link_to t("rails_ai_admin.layout.overview"), root_path, aria: { current: (controller_path == "rails_ai_admin/dashboard" ? "page" : nil) } %>
        <% if assistant_available? %><%= link_to t("rails_ai_admin.layout.assistant"), assistant_path, aria: { current: (controller_path == "rails_ai_admin/assistant" ? "location" : nil) } %><% end %>
        <% if RailsAiAdmin.configuration.mcp && assistant_available? %><%= link_to t("rails_ai_admin.mcp.nav"), mcp_tokens_path, aria: { current: (controller_path == "rails_ai_admin/mcp_tokens" ? "location" : nil) } %><% end %>
        <% if audit_log_available? %><%= link_to t("rails_ai_admin.layout.audit_log"), audit_log_path, aria: { current: (controller_path == "rails_ai_admin/audit" ? "location" : nil) } %><% end %>
        <% if collection_jobs_available? %><%= link_to t("rails_ai_admin.layout.collection_jobs"), collection_jobs_path, aria: { current: (controller_path == "rails_ai_admin/collection_jobs" ? "location" : nil) } %><% end %>
      </div>
      <%= render "rails_ai_admin/shared/navigation", groups: resource_navigation %>
    </nav>
    <main id="raa-main" tabindex="-1">
      <% if return_state_discarded? %><p class="raa-notice" role="status"><%= t("rails_ai_admin.layout.return_state_discarded") %></p><% end %>
      <% flash.each do |_, message| %><p class="raa-notice" role="status"><%= message %></p><% end %>
      <%= yield %>
    </main>
  </div>
</body>
</html>
