<div id="<%= @flow_id %>">
<h1>Confirm <%= @definition.description %></h1>
<p>Review this exact target and input. Nothing has been saved yet. Changed input requires a new review.</p>
<p>Target: <%= @resource.label %> #<%= @record.id %></p>
<dl class="raa-details">
  <% @form_fields.each do |field| %><dt><%= field.label %></dt><dd><%= field.format(@form_values[field.name.to_s], time_zone: @context.time_zone) %></dd><% end %>
</dl>
<% if @proposal.changes.any? %>
  <h2>Proposed visible changes</h2>
  <dl class="raa-details"><% @proposal.changes.each do |name, change| %><% field = @resource.fields.find { |entry| entry.name.to_s == name } %><dt><%= field.label %></dt><dd><%= field.format(change["before"], time_zone: @context.time_zone) %> → <%= field.format(change["after"], time_zone: @context.time_zone) %></dd><% end %></dl>
<% end %>
<%= form_with url: operation_execute_path(resource: @resource.key, id: @record.id, operation: @definition.key), method: :post, local: true do |form| %>
  <%= hidden_field_tag :intent_ref, @proposal.intent.id %>
  <%= hidden_field_tag :confirmed_input, @wire_input %>
  <div class="raa-actions"><%= form.submit "Confirm and execute", data: { turbo_submits_with: "Executing…" } %>
  <%= link_to "Edit input", operation_form_path(resource: @resource.key, id: @record.id, operation: @definition.key) %>
  <%= link_to "Cancel", resource_path(resource: @resource.key, id: @record.id) %></div>
<% end %>
</div>
