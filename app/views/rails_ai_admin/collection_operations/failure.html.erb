<% admin_title t("rails_ai_admin.collection_operations.failure_title"), @resource.label %>
<h1><%= t("rails_ai_admin.collection_operations.failure_title") %></h1>
<% if @uncertain_job_ref %>
<p><%= t("rails_ai_admin.collection_operations.uncertain") %></p>
<p><%= link_to t("rails_ai_admin.collection_operations.check_run"), collection_job_path(job_ref: @uncertain_job_ref, **navigation_params) %></p>
<% else %>
<p><%= admin_outcome(@failure_code) %></p>
<p><%= t("rails_ai_admin.collection_operations.failure_note") %></p>
<% end %>
<p><%= link_to t("rails_ai_admin.collection_operations.return"), list_return_path %></p>
