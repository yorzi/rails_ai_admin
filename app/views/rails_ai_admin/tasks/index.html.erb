<% admin_title t("rails_ai_admin.tasks.title") %>
<h1><%= t("rails_ai_admin.tasks.title") %></h1>
<p><%= t("rails_ai_admin.tasks.intro") %></p>

<% if RailsAiAdmin::Recipe.table_exists? && RailsAiAdmin::Recipe.exists?(tenant_ref: @context.tenant_ref, owner_ref: @context.actor_ref) %>
  <p><%= link_to t("rails_ai_admin.recipes.title"), admin_recipes_path %></p>
<% end %>

<nav aria-label="<%= t("rails_ai_admin.tasks.tabs_label") %>">
  <ul class="raa-tabs">
    <% RailsAiAdmin::Tasks::Coordinator::TABS.each do |tab| %>
      <li><%= link_to t("rails_ai_admin.tasks.tabs.#{tab}"), admin_tasks_path(tab: tab, resource: @resource_filter, kind: @kind_filter),
        aria: { current: (@current_tab == tab ? "page" : nil) } %></li>
    <% end %>
  </ul>
</nav>

<% if @tasks.empty? %>
  <p><%= t("rails_ai_admin.tasks.empty") %></p>
<% else %>
  <div class="raa-table-scroll">
    <table>
      <caption><%= t("rails_ai_admin.tasks.tabs.#{@current_tab}") %></caption>
      <thead>
        <tr>
          <th scope="col"><%= t("rails_ai_admin.tasks.columns.task") %></th>
          <th scope="col"><%= t("rails_ai_admin.tasks.columns.kind") %></th>
          <th scope="col"><%= t("rails_ai_admin.tasks.columns.status") %></th>
          <th scope="col"><%= t("rails_ai_admin.tasks.columns.proposed_by") %></th>
          <th scope="col"><%= t("rails_ai_admin.tasks.columns.updated") %></th>
        </tr>
      </thead>
      <tbody>
        <% @tasks.each do |task| %>
          <% status = RailsAiAdmin::Tasks::Coordinator.effective_status(task) %>
          <tr>
            <th scope="row"><%= link_to task.title, admin_task_path(id: task.id) %></th>
            <td><%= t("rails_ai_admin.tasks.kinds.#{task.kind}", default: task.kind.humanize) %></td>
            <td><%= t("rails_ai_admin.tasks.statuses.#{status}", default: status.humanize) %></td>
            <td><%= @actor_labels[task.created_by_actor_ref] %></td>
            <td><%= task.updated_at.in_time_zone(@context.time_zone).strftime("%Y-%m-%d %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
