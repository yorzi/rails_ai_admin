<% admin_title t("rails_ai_admin.reports.title"), @resource.label %>
<h1><%= @resource.label %> · <%= t("rails_ai_admin.reports.title") %></h1>
<p><%= link_to @resource.label, resources_path(resource: @resource.key) %></p>
<% if @reports.empty? %><p><%= t("rails_ai_admin.reports.empty") %></p><% end %>
<% @reports.each do |report| %>
  <%= render "rails_ai_admin/saved_queries/report", report: report %>
  <% if report.query.owned_by?(@context) %>
    <%= button_to t(report.query.pinned? ? "rails_ai_admin.reports.unpin" : "rails_ai_admin.reports.pin"), saved_query_path(resource: @resource.key, id: report.query.id), method: :patch, params: { pinned: report.query.pinned? ? "0" : "1" } %>
    <%= button_to t("rails_ai_admin.reports.delete"), saved_query_path(resource: @resource.key, id: report.query.id), method: :delete %>
  <% end %>
<% end %>
