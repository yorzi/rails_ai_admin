<p><%= link_to @resource.label, resources_path(resource: @resource.key) %></p>
<h1>Selected records</h1>
<p><%= pluralize(@selection.targets.size, "fixed target") %>. This selection does not approve or execute an operation.</p>
<p>Expires <time datetime="<%= @selection.expires_at.iso8601 %>"><%= @selection.expires_at.in_time_zone(@context.time_zone).strftime("%Y-%m-%d %H:%M:%S %Z") %></time>.</p>
<div class="raa-table-scroll" role="region" aria-label="Selected records" tabindex="0">
<table><caption><%= @resource.label %> — fixed selection</caption>
<thead><tr><th scope="col">Record</th><th scope="col">ID</th><th scope="col">Version</th></tr></thead>
<tbody><% @selection.targets.each do |target| %><tr>
  <td><%= link_to target.label, resource_path(resource: @resource.key, id: target.id) %></td>
  <td><%= target.id %></td><td><%= target.expected_version %></td>
</tr><% end %></tbody></table></div>
<p>Changes to a selected record require a fresh selection. Unselected and newly matching records are never added automatically.</p>
<% @operations.each do |operation| %>
  <p><%= link_to operation.description, collection_operation_form_path(resource: @resource.key, operation: operation.key, selection_ref: @selection.selection_ref), class: "raa-button" %></p>
<% end %>
