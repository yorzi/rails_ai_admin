<p><%= link_to t("rails_ai_admin.bulk_changes.back"), return_path %></p>
<% admin_title t("rails_ai_admin.bulk_changes.title", label: @resource.label), @resource.label %>
<h1><%= t("rails_ai_admin.bulk_changes.title", label: @resource.label) %></h1>
<p><%= t("rails_ai_admin.bulk_changes.intro") %></p>
<% if @revise_error %><p class="raa-field-error" role="alert"><%= @revise_error %></p><% end %>
<p><strong><%= t("rails_ai_admin.bulk_changes.question", count: @ready.size) %></strong></p>
<% if @async_mode %>
  <p class="raa-notice" role="status"><%= t("rails_ai_admin.collection_operations.sampled_preview", shown: (@display_ready || @ready).size, total: @ready.size) %></p>
<% end %>
<%# One form holds the rows, the edited values and every decision, so what is
    confirmed is always what the page shows. The result page renders with
    200, which Turbo would drop after a form post. %>
<%= form_with url: apply_bulk_change_path(selection_ref: @selection.selection_ref), method: :post, local: true, id: "raa-bulk-review", data: { turbo: false } do |form| %>
  <%= hidden_field_tag :change, params[:change], id: nil %>
  <%= hidden_field_tag :review_signature, @review_signature, id: nil if @review_signature %>
  <% shown_items = @display_ready || @ready %>
  <% if shown_items.any? %>
    <% unless @async_mode %>
      <%# Sent even when every row is unticked, so an empty choice is never read as "all". %>
      <%= hidden_field_tag "target_ids[]", "", id: nil %>
    <% end %>
    <div class="raa-table-scroll"><table class="raa-bulk-review">
      <caption class="raa-visually-hidden"><%= t("rails_ai_admin.bulk_changes.caption", count: @ready.size) %></caption>
      <thead><tr>
        <% unless @async_mode %><th scope="col"><span class="raa-visually-hidden"><%= t("rails_ai_admin.bulk_changes.revise.include") %></span></th><% end %>
        <th scope="col"><%= t("rails_ai_admin.collection_jobs.record") %></th>
        <% @fields.each do |field| %><th scope="col"><%= field.label %></th><% end %>
      </tr></thead>
      <tbody><% shown_items.each_with_index do |item, index| %><tr>
        <% unless @async_mode %>
          <td><%= check_box_tag "target_ids[]", item.target.id, @submitted_target_ids.nil? || @submitted_target_ids.include?(item.target.id.to_s), id: "raa-bulk-target-#{index}",
            aria: { label: t("rails_ai_admin.bulk_changes.revise.select_row", label: item.target.label.to_s.truncate(120)) } %></td>
        <% end %>
        <th scope="row"><%= link_to item.target.label, resource_path(resource: @resource.key, id: item.target.id) %></th>
        <% @fields.each do |field| %><td>
          <% if (change = item.changes[field.name.to_s]) %>
            <%= admin_field_value(field, change[0], view: :index, record_id: item.target.id) %> → <%= admin_field_value(field, change[1], view: :index, record_id: item.target.id) %>
          <% else %>
            <span class="raa-muted"><%= t("rails_ai_admin.bulk_changes.hidden_value") %></span>
          <% end %>
        </td><% end %>
      </tr><% end %></tbody>
    </table></div>
  <% end %>
  <% if @skipped.any? %>
    <h2><%= t("rails_ai_admin.bulk_changes.skipped", count: @skipped.size) %></h2>
    <ul><% @skipped.each do |item| %><li><%= item.target.label %>: <%= admin_outcome(item.code) %></li><% end %></ul>
  <% end %>
  <p><%= t("rails_ai_admin.bulk_changes.each_note") %></p>
  <% if @ready.any? %>
    <%# Before the decisions, so pressing Enter in a value updates the preview. %>
    <details class="raa-bulk-revise-panel"<%= " open" if @revise_error %>>
      <summary><%= t("rails_ai_admin.bulk_changes.revise.heading") %></summary>
      <p class="raa-field-help"><%= t("rails_ai_admin.bulk_changes.revise.note") %></p>
      <% @fields.each do |field| %>
        <% current_value = (@submitted_values || @proposal.values)[field.name.to_s] %>
        <% allow_blank = field.options[:nullable] && !field.options[:required] %>
        <div class="raa-field">
          <%= label_tag "raa-revise-#{field.name}", field.label %>
          <% if field.scalar_type == :boolean %>
            <%= select_tag "values[#{field.name}]", options_for_select([ [ t("rails_ai_admin.fields.yes"), "true" ], [ t("rails_ai_admin.fields.no"), "false" ] ], current_value.to_s),
              id: "raa-revise-#{field.name}", include_blank: (allow_blank ? t("rails_ai_admin.fields.not_set") : false) %>
          <% elsif %i[enum select].include?(field.scalar_type) %>
            <%= select_tag "values[#{field.name}]", options_for_select(field.choice_options, current_value.to_s),
              id: "raa-revise-#{field.name}", include_blank: (allow_blank ? t("rails_ai_admin.fields.not_set") : false) %>
          <% else %>
            <%= text_field_tag "values[#{field.name}]", current_value.to_s, id: "raa-revise-#{field.name}", maxlength: field.options[:max_length] %>
          <% end %>
        </div>
      <% end %>
      <div class="raa-actions">
        <%= form.button t("rails_ai_admin.bulk_changes.revise.submit"), name: "decision", value: "revise", type: "submit", class: "raa-secondary" %>
      </div>
    </details>
  <% end %>
  <div class="raa-actions">
    <% if @ready.any? %>
      <%= form.button t("rails_ai_admin.bulk_changes.submit", count: @ready.size), name: "decision", value: "confirm", type: "submit",
        data: { turbo_submits_with: t("rails_ai_admin.bulk_changes.updating") } %>
    <% end %>
    <%= form.button t("rails_ai_admin.bulk_changes.dismiss"), name: "decision", value: "dismiss", type: "submit", class: "raa-secondary" %>
  </div>
<% end %>
