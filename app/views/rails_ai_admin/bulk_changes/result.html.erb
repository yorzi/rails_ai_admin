<p><%= link_to t("rails_ai_admin.bulk_changes.back"), return_path %></p>
<% admin_title t("rails_ai_admin.bulk_changes.result_title"), @resource.label %>
<h1><%= t("rails_ai_admin.bulk_changes.result_title") %></h1>
<p role="status"><%= t("rails_ai_admin.bulk_changes.updated", count: @updated) %></p>
<% if @failed.any? %>
  <h2><%= t("rails_ai_admin.bulk_changes.not_updated") %></h2>
  <div class="raa-table-scroll"><table>
    <thead><tr><th scope="col"><%= t("rails_ai_admin.collection_jobs.record") %></th><th scope="col"><%= t("rails_ai_admin.selections.destroy.reason") %></th></tr></thead>
    <tbody><% @failed.each do |target, code| %><tr>
      <td><% if code == "NOT_FOUND" %><%= target.label %><% else %><%= link_to target.label, resource_path(resource: @resource.key, id: target.id) %><% end %></td>
      <td><%= admin_outcome(code) %></td>
    </tr><% end %></tbody>
  </table></div>
<% end %>
<p><%= link_to t("rails_ai_admin.bulk_changes.open_list", label: @resource.label), resources_path(resource: @resource.key) %></p>
