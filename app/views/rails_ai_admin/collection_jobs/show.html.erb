<% admin_title @job.description, t("rails_ai_admin.layout.collection_jobs") %>
<p><%= link_to t("rails_ai_admin.layout.collection_jobs"), collection_jobs_path %> · <%= link_to list_return_label, list_return_path %></p>
<h1><%= @job.description %></h1>
<p><%= t("rails_ai_admin.collection_jobs.status_html", status: tag.strong(admin_state_name(@job.status))) %></p>
<% if @job.waiting_since %>
  <p class="raa-notice" role="status"><%= t("rails_ai_admin.collection_jobs.waiting", age: distance_of_time_in_words(@job.waiting_since, Time.current)) %>
  <% if @job.waiting_since < 5.minutes.ago %><%= t("rails_ai_admin.collection_jobs.waiting_hint_html", queue: tag.code(RailsAiAdmin.configuration.queue_name)) %><% end %></p>
<% end %>
<p><%= admin_state_counts(@job.counts) %></p>
<p><%= link_to t("rails_ai_admin.collection_jobs.refresh"), collection_job_path(job_ref: @job.job_ref, **navigation_params) %></p>
<% if @job.warning %><p class="raa-errors" role="alert"><%= t("rails_ai_admin.collection_jobs.warning") %></p><% end %>
<% if @job.can_cancel %>
  <%= button_to t("rails_ai_admin.collection_jobs.cancel"), cancel_collection_job_path(job_ref: @job.job_ref), method: :post, params: navigation_params, data: { turbo: false } %>
<% end %>
<p><%= t("rails_ai_admin.collection_jobs.committed_note") %></p>
<div class="raa-table-scroll" role="region" aria-label="<%= t("rails_ai_admin.collection_jobs.items") %>" tabindex="0"><table>
<caption><%= t("rails_ai_admin.collection_jobs.items") %></caption>
<thead><tr><th scope="col"><%= t("rails_ai_admin.collection_jobs.record") %></th><th scope="col"><%= t("rails_ai_admin.collection_jobs.business_status") %></th><th scope="col"><%= t("rails_ai_admin.collection_jobs.reason") %></th><th scope="col"><%= t("rails_ai_admin.collection_jobs.follow_up") %></th></tr></thead>
<tbody><% @job.entries.each do |entry| %><tr>
<td><%= link_to entry.label, resource_path(resource: @resource.key, id: entry.record_id, **navigation_params) %></td>
<td><%= admin_state_name(entry.status) %><% if entry.warning %> <%= t("rails_ai_admin.collection_jobs.callback_warning") %><% end %></td><td><%= admin_outcome(entry.code) if entry.code && entry.code != "OK" %></td>
<td><%= admin_state_counts(entry.work_statuses) %></td>
</tr><% end %></tbody></table></div>
<% if @job.hidden_count > 0 %><p><%= t("rails_ai_admin.collection_jobs.hidden") %></p><% end %>
