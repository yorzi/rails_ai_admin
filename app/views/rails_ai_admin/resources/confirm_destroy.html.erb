<% heading = t("rails_ai_admin.resources.destroy.title", label: record_label(@resource, @record)) %>
<% admin_title heading, @resource.label %>
<h1><%= heading %></h1>
<%= render "errors" %>
<p><%= t(@resource.soft_delete? ? "rails_ai_admin.resources.destroy.question_soft_html" : "rails_ai_admin.resources.destroy.question_html", label: tag.strong(record_label(@resource, @record))) %></p>
<% if @resource.soft_delete? %><p><%= t("rails_ai_admin.deleted_records.destroy_note") %></p><% end %>
<%= form_with url: resource_path(resource: @resource.key, id: @record.id), method: :delete, local: true do |form| %>
  <%= return_navigation_fields %>
  <%= parent_return_fields %>
  <%= hidden_field_tag :intent_ref, @intent_ref %>
  <%= form.submit t("rails_ai_admin.resources.destroy.confirm"), class: "raa-danger", disabled: @needs_reload %>
  <%= link_to t("rails_ai_admin.actions.cancel"), parent_return_path || resource_path(resource: @resource.key, id: @record.id, **navigation_params) %>
<% end %>
