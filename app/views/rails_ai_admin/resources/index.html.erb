<div class="raa-heading"><h1><%= @resource.label %></h1>
<% if allowed_action?(@resource, :create) %><%= link_to "New record", new_resource_path(resource: @resource.key), class: "raa-button" %><% end %></div>
<% if @searchable %>
  <%= form_with url: resources_path(resource: @resource.key), method: :get, local: true, class: "raa-search" do |form| %>
    <%= form.label :q, "Search" %><%= form.search_field :q, value: params[:q], maxlength: 200 %>
    <%= form.submit "Search" %>
  <% end %>
<% end %>
<% if @selectable %>
  <%= form_with url: capture_selection_path(resource: @resource.key), method: :post, local: true, id: "raa-selection", data: { turbo: false } do |form| %>
    <p>Select records on this page, then capture their current versions. Up to 100 targets; this does not execute changes.</p>
    <%= form.submit "Capture selection" %>
  <% end %>
<% end %>
<div class="raa-table-scroll" role="region" aria-label="Resource records" tabindex="0">
<table><caption><%= @resource.label %>, page <%= @page.number %></caption>
<thead><tr><% if @selectable %><th scope="col">Select</th><% end %><% @columns.each do |field| %><th scope="col"><%= field.label %></th><% end %><th scope="col">Actions</th></tr></thead>
<tbody><% @rows.each_with_index do |row, index| %><tr>
  <% if @selectable %><td><%= check_box_tag "target_ids[]", row[:id], false, id: "raa-target-#{index}", form: "raa-selection", aria: { label: "Select #{row[:label].to_s.truncate(120)}" } %></td><% end %>
  <% @columns.each do |field| %><td><%= admin_field_value(field, row[:values][field.name.to_s], view: :index) if row[:values].key?(field.name.to_s) %></td><% end %>
  <td><%= link_to "View #{row[:label]}", resource_path(resource: @resource.key, id: row[:id]) %></td>
</tr><% end %></tbody></table></div>
<% if @rows.empty? %><p>No records match this query.</p><% end %>
<nav class="raa-pagination" aria-label="Pagination">
  <% if @page.number > 1 %><%= link_to "Previous", resources_path(resource: @resource.key, q: params[:q], sort: params[:sort], direction: params[:direction], page: @page.number - 1) %><% end %>
  <% if @page.has_next %><%= link_to "Next", resources_path(resource: @resource.key, q: params[:q], sort: params[:sort], direction: params[:direction], page: @page.number + 1) %><% end %>
</nav>
