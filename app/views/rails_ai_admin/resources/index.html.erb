<% admin_title @resource.label %>
<%# The first screen shows records: search sits beside the heading, filters fold away (RAA-025). %>
<% creatable = allowed_action?(@resource, :create) %>
<div class="raa-heading raa-list-heading"><h1><%= @resource.label %></h1>
<% if @searchable || @exportable || @importable || creatable %>
<div class="raa-actions raa-list-toolbar">
<% if @searchable %>
  <%= form_with url: resources_path(resource: @resource.key), method: :get, local: true, class: "raa-search", html: { role: "search", aria: { label: t("rails_ai_admin.resources.index.search_label", label: @resource.label.downcase_first) } } do |form| %>
    <%= form.label :q, t("rails_ai_admin.resources.index.search_label", label: @resource.label.downcase_first), class: "raa-visually-hidden" %><%= form.search_field :q, value: navigation_state["q"], maxlength: 200, size: 24, placeholder: admin_search_placeholder(@access.fields(:search)) %>
    <%= list_state_fields("sort", "direction", "scope", "filter") %>
    <%= form.submit t("rails_ai_admin.resources.index.search") %>
  <% end %>
<% end %>
<% if @exportable %>
  <%= form_with url: resource_export_path(resource: @resource.key), method: :post, local: true, class: "raa-export", data: { turbo: false } do |form| %>
    <%= list_state_fields("q", "sort", "direction", "scope", "filter") %>
    <%= form.submit t("rails_ai_admin.exports.button"), class: "raa-secondary", name: nil %>
  <% end %>
<% end %>
<% if @importable %><%= link_to t("rails_ai_admin.imports.button"), new_resource_import_path(resource: @resource.key), class: "raa-button raa-secondary" %><% end %>
<% if creatable %><%= link_to t("rails_ai_admin.resources.new", label: @resource.label.singularize.downcase_first), new_resource_path(resource: @resource.key, **navigation_params), class: "raa-button" %><% end %>
</div>
<% end %>
</div>
<% if assistant_for?(@resource) %><%= render "rails_ai_admin/assistant/ask", resource: @resource, record: nil %><% end %>
<% if @list_scopes.any? %>
  <nav class="raa-scopes" aria-label="<%= t("rails_ai_admin.resources.index.scopes", label: @resource.label) %>"><ul>
    <% @list_scopes.each do |definition| %>
      <% state = navigation_state.except("page", "scope") %>
      <% state = state.merge("scope" => definition.name.to_s) unless definition.default? %>
      <li><%= link_to definition.label, resources_path(resource: @resource.key, **state.symbolize_keys), aria: { current: @current_scope == definition.name.to_s ? "true" : nil } %></li>
    <% end %>
  </ul></nav>
  <% if navigation_state["scope"] == RailsAiAdmin::Queries::NamedScope::NONE %><p class="raa-notice" role="status"><%= t("rails_ai_admin.resources.index.no_list_tab") %></p><% end %>
<% end %>
<% if @saved_views %>
  <% current_view = navigation_state.except("page") %>
  <details class="raa-saved-views"<% if @saved_views.any? %> open<% end %>>
  <summary><%= t("rails_ai_admin.saved_views.title") %><% if @saved_views.any? %> (<%= @saved_views.size %>)<% end %></summary>
  <% if @saved_views.any? %><ul class="raa-saved-view-list">
    <% @saved_views.each do |view| %><li>
      <%= link_to view.name, resources_path(resource: @resource.key, **view.state.symbolize_keys), aria: { current: view.state == current_view ? "true" : nil } %>
      <%= form_with url: saved_view_path(resource: @resource.key, id: view.id), method: :delete, local: true, class: "raa-inline-form" do %>
        <%= return_navigation_fields %>
        <%= button_tag t("rails_ai_admin.saved_views.delete"), type: "submit", name: nil, class: "raa-link-button", aria: { label: t("rails_ai_admin.saved_views.delete_named", name: view.name) } %>
      <% end %>
    </li><% end %>
  </ul><% end %>
  <%= form_with url: saved_views_path(resource: @resource.key), method: :post, local: true, class: "raa-save-view" do |form| %>
    <%= return_navigation_fields %>
    <%= form.label :name, t("rails_ai_admin.saved_views.name"), for: "raa-saved-view-name" %>
    <%= form.text_field :name, id: "raa-saved-view-name", maxlength: RailsAiAdmin::Navigation::SavedViews::MAX_NAME, required: true, autocomplete: "off" %>
    <%= form.submit t("rails_ai_admin.saved_views.save"), name: nil, class: "raa-secondary" %>
    <p class="raa-field-help"><%= t("rails_ai_admin.saved_views.help") %></p>
  <% end %>
  </details>
<% end %>
<% if @filter_fields.any? %>
  <% active_filters = navigation_state["filter"].to_h.values.sum(&:size) %>
  <details class="raa-filter-panel"<% if active_filters.positive? %> open<% end %>>
  <summary><%= t("rails_ai_admin.resources.index.filters") %><% if active_filters.positive? %> (<%= t("rails_ai_admin.resources.index.active_filters", count: active_filters) %>)<% end %></summary>
  <%= form_with url: resources_path(resource: @resource.key), method: :get, local: true, class: "raa-filters" do |form| %>
    <fieldset><legend><%= t("rails_ai_admin.resources.index.filters") %></legend>
      <% @filter_fields.each do |field| %><% field.filter_operators.each do |operator| %>
        <% id = "raa-filter-#{field.name}-#{operator}" %>
        <% if operator == :in %><%= admin_filter_choices(field, navigation_state.dig("filter", field.name.to_s, "in"), id: id) %><% next %><% end %>
        <div class="raa-filter"><label for="<%= id %>"><%= admin_filter_label(field, operator) %></label>
        <%= admin_filter_input(field, operator, navigation_state.dig("filter", field.name.to_s, operator.to_s), id: id) %></div>
      <% end %><% end %>
    </fieldset>
    <%= list_state_fields("q", "sort", "direction", "scope") %>
    <div class="raa-actions"><%= form.submit t("rails_ai_admin.resources.index.apply_filters"), name: nil %>
    <% if navigation_state["filter"] %><%= link_to t("rails_ai_admin.resources.index.clear_filters"), resources_path(resource: @resource.key, **navigation_state.except("filter", "page").symbolize_keys) %><% end %></div>
  <% end %>
  </details>
<% end %>
<% if navigation_state.any? %><p><%= link_to t("rails_ai_admin.resources.index.reset"), resources_path(resource: @resource.key) %></p><% end %>
<% if @omitted_rows %><p class="raa-notice" role="status"><%= t("rails_ai_admin.resources.index.omitted_rows") %></p><% end %>
<% if @page.count %><p class="raa-count"><%= @page.count_capped ? t("rails_ai_admin.resources.index.count_capped", count: @page.count, number: number_with_delimiter(@page.count)) : t("rails_ai_admin.resources.index.count", count: @page.count, number: number_with_delimiter(@page.count)) %></p><% end %>
<% if @selectable %>
  <%# One step from ticked rows to the reviewed action. Each button captures the
      ticked records first; the action's own review page still confirms. %>
  <% counts = { none: t("rails_ai_admin.resources.index.selected.none"), one: t("rails_ai_admin.resources.index.selected.one"), other: t("rails_ai_admin.resources.index.selected.other") } %>
  <%= form_with url: capture_selection_path(resource: @resource.key), method: :post, local: true, id: "raa-selection", class: "raa-selection-bar", data: { turbo: false, controller: "raa-selection", raa_selection_counts_value: counts.to_json } do |form| %>
    <%= return_navigation_fields %>
    <span class="raa-selection-count" data-raa-selection-target="count" aria-live="polite"><%= t("rails_ai_admin.resources.index.selection_help") %></span>
    <% @bulk_operations.each do |operation| %>
      <%= button_tag operation.description, type: "submit", name: "then", value: "operation:#{operation.key}", data: { raa_selection_target: "submit" } %>
    <% end %>
    <% if @bulk_destroy %><%= button_tag t("rails_ai_admin.resources.index.delete_selected"), type: "submit", name: "then", value: "destroy", class: "raa-danger", data: { raa_selection_target: "submit" } %><% end %>
    <%= button_tag t("rails_ai_admin.resources.index.capture_selection"), type: "submit", name: nil, class: "raa-secondary", data: { raa_selection_target: "submit" } %>
  <% end %>
<% end %>
<%# The title column links to the record, around the field's own list display
    (plain label text for types that render a link of their own). Without a
    title column each row gets a View link. %>
<% title_column = @columns.any? { |field| field.name == @resource.title } %>
<% row_actions = !title_column || @rows.any? { |row| row[:editable] } %>
<div class="raa-table-scroll" role="region" aria-label="<%= t("rails_ai_admin.resources.index.records_region") %>" tabindex="0">
<table><caption><%= t("rails_ai_admin.resources.index.caption", label: @resource.label, page: @page.number) %></caption>
<thead><tr><% if @selectable %><th scope="col"><span class="raa-visually-hidden"><%= t("rails_ai_admin.resources.index.select") %></span><input type="checkbox" hidden data-raa-select-all aria-label="<%= t("rails_ai_admin.resources.index.select_all") %>"></th><% end %><% @columns.each do |field| %>
  <% sorted = @page.sort == field.name.to_s %>
  <% direction = @page.direction %>
  <th scope="col"<% if @sortable_fields.include?(field) %> aria-sort="<%= sorted ? (direction == "asc" ? "ascending" : "descending") : "none" %>"<% end %>>
    <% if @sortable_fields.include?(field) %>
      <% state = navigation_state.except("page").merge("sort" => field.name.to_s, "direction" => sorted && direction == "asc" ? "desc" : "asc") %>
      <%= link_to field.label, resources_path(resource: @resource.key, **state.symbolize_keys) %>
    <% else %><%= field.label %><% end %>
  </th>
<% end %><% if row_actions %><th scope="col"><%= t("rails_ai_admin.resources.index.actions") %></th><% end %></tr></thead>
<tbody><% @rows.each_with_index do |row, index| %><tr>
  <% if @selectable %><td><%= check_box_tag "target_ids[]", row[:id], false, id: "raa-target-#{index}", form: "raa-selection", aria: { label: t("rails_ai_admin.resources.index.select_row", label: row[:label].to_s.truncate(120)) } %></td><% end %>
  <% @columns.each do |field| %><td<% if field.name == @resource.title %> class="raa-cell-title"<% elsif RailsAiAdmin::Presentation::IndexSettings::COMPACT_TYPES.include?(field.scalar_type) %> class="raa-cell-compact"<% end %>><% if field.name == @resource.title %><%= link_to resource_path(resource: @resource.key, id: row[:id], **navigation_params), class: "raa-row-title" do %><% if row[:values].key?(field.name.to_s) && !RailsAiAdmin::Presentation::IndexSettings::SELF_LINKING_TYPES.include?(field.scalar_type) %><%= admin_field_value(field, row[:values][field.name.to_s], view: :index, record_id: row[:id]) %><% else %><%= row[:label] %><% end %><% end %><% elsif row[:values].key?(field.name.to_s) %><%= admin_field_value(field, row[:values][field.name.to_s], view: :index, record_id: row[:id]) %><% end %></td><% end %>
  <% if row_actions %><td class="raa-row-actions"><% unless title_column %><%= link_to t("rails_ai_admin.resources.index.view"), resource_path(resource: @resource.key, id: row[:id], **navigation_params), aria: { label: t("rails_ai_admin.resources.index.view_row", label: row[:label]) } %><% end %>
    <% if row[:editable] %><%= link_to t("rails_ai_admin.resources.edit"), edit_resource_path(resource: @resource.key, id: row[:id], **navigation_params), aria: { label: t("rails_ai_admin.resources.edit_title", label: row[:label]) } %><% end %></td><% end %>
</tr><% end %></tbody></table></div>
<% if @rows.empty? && !@omitted_rows %><p><%= t("rails_ai_admin.resources.index.empty") %></p><% end %>
<%# With an exact count the list shows numbered pages; otherwise Previous/Next. %>
<% last_page = @page.count && !@page.count_capped ? [ [ (@page.count - 1).div(@page.page_size) + 1, 1 ].max, 1000 ].min : nil %>
<% if @page.number > 1 || @page.has_next %>
<nav class="raa-pagination" aria-label="<%= t("rails_ai_admin.resources.index.pagination") %>">
  <% if @page.number > 1 %><%= link_to t("rails_ai_admin.resources.index.previous"), list_page_path(@page.number - 1), rel: "prev" %><% end %>
  <% if last_page %><ol class="raa-page-numbers">
    <% admin_page_window(@page.number, last_page).each do |number| %>
      <% if number.nil? %><li aria-hidden="true">…</li>
      <% elsif number == @page.number %><li><span aria-current="page"><span class="raa-visually-hidden"><%= t("rails_ai_admin.resources.index.page") %> </span><%= number %></span></li>
      <% else %><li><%= link_to list_page_path(number), aria: { label: t("rails_ai_admin.resources.index.page_number", number: number) } do %><%= number %><% end %></li><% end %>
    <% end %>
  </ol><% else %><span class="raa-page-current"><%= t("rails_ai_admin.resources.index.page_number", number: @page.number) %></span><% end %>
  <% if @page.has_next && @page.number < 1000 %><%= link_to t("rails_ai_admin.resources.index.next"), list_page_path(@page.number + 1), rel: "next" %><% end %>
</nav>
<% end %>

<% if @page.has_next && @page.number == 1000 %><p><%= t("rails_ai_admin.resources.index.page_limit") %></p><% end %>
