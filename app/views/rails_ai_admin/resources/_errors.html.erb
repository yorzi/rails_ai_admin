<% if @failure_code || @errors.any? %>
  <% form_builder = local_assigns[:form] %>
  <% editable = Array(local_assigns[:fields]).index_by { |field| field.name.to_s } %>
  <div class="raa-errors" role="alert" tabindex="-1" data-controller="raa-error-summary">
    <h2><%= t("rails_ai_admin.errors.title") %></h2>
    <% if @failure_code %><p><%= admin_outcome(@failure_code) %></p><% end %>
    <ul><% @errors.each do |name, messages| %><% messages.each do |message| %><li>
      <% if form_builder && editable[name] %>
        <a href="#<%= form_builder.field_id(name) %>" data-action="click->raa-error-summary#reveal" data-raa-target-field="<%= form_builder.field_id(name) %>"><%= editable[name].label %> <%= message %></a>
      <% elsif name == "base" %><%= message.upcase_first %><% else %><%= name.humanize %> <%= message %><% end %>
    </li><% end %><% end %></ul>
    <% if @needs_reload %><p><%= t("rails_ai_admin.errors.needs_reload") %></p><% end %>
  </div>
<% end %>
