<p><%= link_to @resource.label, resources_path(resource: @resource.key) %></p>
<div class="raa-heading"><h1><%= record_label(@resource, @record) %></h1>
<div class="raa-actions">
  <% if allowed_action?(@resource, :update, @record) %><%= link_to "Edit", edit_resource_path(resource: @resource.key, id: @record.id), class: "raa-button" %><% end %>
  <% if allowed_action?(@resource, :destroy, @record) %><%= link_to "Delete", confirm_destroy_resource_path(resource: @resource.key, id: @record.id), class: "raa-danger" %><% end %>
  <% @operations.each do |operation| %><%= link_to operation.description, operation_form_path(resource: @resource.key, id: @record.id, operation: operation.key), class: "raa-button" %><% end %>
</div></div>
<dl class="raa-details"><% @fields.each do |field| %><dt><%= field.label %></dt><dd><%= admin_field_value(field, @values[field.name.to_s], view: :show) %></dd><% end %></dl>
