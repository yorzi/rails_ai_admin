<div class="raa-notice" hidden role="status" tabindex="-1" data-raa-form-recovery-target="notice">
  <p data-raa-form-recovery-target="message"><%= t("rails_ai_admin.recovery.notice") %></p>
  <% if RailsAiAdmin.configuration.authentication_path %><p><%= link_to t("rails_ai_admin.recovery.sign_in"), RailsAiAdmin.configuration.authentication_path, target: "_blank", rel: "noopener noreferrer", data: { turbo: false } %></p><% else %><p><%= t("rails_ai_admin.recovery.sign_in_elsewhere") %></p><% end %>
  <button type="button" data-raa-form-recovery-target="resume" data-action="raa-form-recovery#resume" disabled><%= t("rails_ai_admin.recovery.resume") %></button>
</div>
