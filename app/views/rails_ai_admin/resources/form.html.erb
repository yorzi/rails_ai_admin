<p><%= link_to list_return_label, list_return_path %></p>
<h1><%= @operation == :create ? "New record" : "Edit record" %></h1>
<% target = @operation == :create ? resources_path(resource: @resource.key) : resource_path(resource: @resource.key, id: @record.id) %>
<%= form_with url: target, method: (@operation == :create ? :post : :patch), local: true, scope: :record, namespace: "raa_#{@resource.key}_#{@record.id || 'new'}", data: { controller: "raa-dirty-form raa-form-recovery", raa_form_recovery_url_value: recover_resource_form_path(resource: @resource.key), raa_form_recovery_intent_value: @intent.id, raa_form_recovery_time_zone_value: @context.time_zone, raa_form_recovery_return_state_value: encoded_return_state, raa_form_recovery_return_discarded_value: return_state_discarded?, raa_form_recovery_fields_value: @form_fields.map { |field| field.name.to_s }, action: "raa:form-paused->raa-dirty-form#pause input->raa-dirty-form#change submit->raa-dirty-form#submit turbo:submit-end->raa-dirty-form#finish turbo:before-fetch-response->raa-form-recovery#inspectResponse turbo:submit-end->raa-form-recovery#finished" } do |form| %>
  <%= render "rails_ai_admin/resources/recovery" %>
  <%= return_navigation_fields %>
  <%= hidden_field_tag :intent_ref, @intent.id %>
  <%= render "errors", form: form, fields: @form_fields %>
  <%= render "rails_ai_admin/shared/input_fields", form: form, fields: @form_fields, values: @form_values, errors: @errors, plan: @form_plan %>
  <div class="raa-actions"><%= form.submit "Save", disabled: @needs_reload, data: { turbo_submits_with: "Saving…" } %>
  <%= link_to "Cancel", list_return_path %></div>
<% end %>
