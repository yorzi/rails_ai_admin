<%= turbo_frame_tag "raa_assistant_transcript", class: "raa-chat", data: {
  controller: "raa-poll",
  raa_poll_url_value: assistant_conversation_path(chat_ref: @chat.ref, drawer: (@drawer ? "1" : nil)),
  raa_poll_status_frame_value: "raa_assistant_turn_status",
  raa_poll_status_url_value: assistant_conversation_path(chat_ref: @chat.ref, drawer: (@drawer ? "1" : nil), status_only: "1")
} do %>
  <% if !@current %>
    <div class="raa-conversation-closed">
      <p class="raa-notice" role="status"><%= @chat.status == "archived" ? t("rails_ai_admin.assistant.archived_note") : t("rails_ai_admin.assistant.closed_note") %></p>
    </div>
  <% elsif @entries.empty? && !@pending && !@failure %>
    <div class="raa-chat-empty">
      <h2><%= t("rails_ai_admin.assistant.empty_title") %></h2>
      <p><%= t("rails_ai_admin.assistant.empty") %></p>
    </div>
  <% end %>
  <ol class="raa-chat-log" role="list" aria-label="<%= t("rails_ai_admin.assistant.conversation") %>">
    <% @entries.each do |entry| %>
      <% case entry.kind %>
      <% when :user %>
        <li class="raa-chat-message raa-chat-user"><span class="raa-chat-role"><%= t("rails_ai_admin.assistant.roles.user") %></span><div class="raa-chat-text"><%= h(entry.text) %></div></li>
      <% when :continuation %>
        <li class="raa-chat-message raa-chat-event"><span class="raa-chat-role"><%= t("rails_ai_admin.assistant.roles.review") %></span><div class="raa-chat-text"><%= h(entry.text) %></div></li>
      <% when :assistant %>
        <li class="raa-chat-message raa-chat-assistant"><span class="raa-chat-role"><%= t("rails_ai_admin.assistant.roles.assistant") %></span><div class="raa-chat-text"><%= h(entry.text) %></div></li>
      <% when :activity %>
        <li class="raa-chat-activity"><%= entry.text %></li>
      <% when :records %>
        <li class="raa-chat-records"><span class="raa-chat-role"><%= t("rails_ai_admin.assistant.roles.records") %></span>
          <ul><% entry.links.each do |link| %><li><%= link_to link.label, resource_path(resource: link.resource_key, id: link.id), data: { turbo_frame: "_top" } %></li><% end %></ul>
        </li>
      <% when :bulk_review %>
        <li class="raa-chat-surface raa-chat-bulk"><div>
          <h2><%= t("rails_ai_admin.assistant.bulk_review.title", count: entry.review.records, label: entry.review.resource_label) %></h2>
          <p><%= t("rails_ai_admin.assistant.bulk_review.note") %></p>
          <p><%= link_to t("rails_ai_admin.assistant.bulk_review.open", count: entry.review.records),
            bulk_change_path(selection_ref: entry.review.selection_ref, change: entry.review.token), data: { turbo_frame: "_top" } %></p>
        </div></li>
        <% if entry.surface_id && @surface_scope %>
          <li class="raa-chat-surface"><%= admin_assistant_surface(entry.surface_id, scope: @surface_scope) %></li>
        <% end %>
      <% when :surface %>
        <li class="raa-chat-surface"><%= admin_assistant_surface(entry.surface_id, scope: @surface_scope) if @surface_scope %></li>
      <% end %>
    <% end %>
  </ol>
  <%= render "rails_ai_admin/assistant/turn_status" %>
<% end %>
