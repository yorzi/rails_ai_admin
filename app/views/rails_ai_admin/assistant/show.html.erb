<p><%= link_to t("rails_ai_admin.assistant.all"), assistant_path %></p>
<% admin_title t("rails_ai_admin.assistant.conversation"), t("rails_ai_admin.layout.assistant") %>
<h1><%= t("rails_ai_admin.assistant.title") %></h1>
<% if !@current %>
  <p class="raa-notice" role="status"><%= @chat.status == "archived" ? t("rails_ai_admin.assistant.archived_note") : t("rails_ai_admin.assistant.closed_note") %></p>
  <%= button_to t("rails_ai_admin.assistant.new"), assistant_conversations_path, method: :post, class: "raa-button" %>
<% else %>
  <%= render "rails_ai_admin/assistant/transcript" %>
  <%= form_with url: assistant_messages_path(chat_ref: @chat.ref), method: :post, class: "raa-chat-composer" do |form| %>
    <%= hidden_field_tag :admission_key, @admission_key, id: nil %>
    <%= form.label :content, t("rails_ai_admin.assistant.message") %>
    <% if @message_error %><p class="raa-field-error" id="raa-chat-error"><%= @message_error %></p><% end %>
    <%= form.text_area :content, value: @draft, rows: 3, maxlength: RailsAiAdmin::Assistant::Coordinator::MAX_CONTENT, required: true,
      aria: { describedby: (@message_error ? "raa-chat-error" : nil), invalid: (@message_error ? true : nil) } %>
    <div class="raa-actions"><%= form.submit t("rails_ai_admin.assistant.send"), class: "raa-button" %></div>
  <% end %>
  <div class="raa-actions">
    <%= button_to t("rails_ai_admin.assistant.archive"), archive_assistant_conversation_path(chat_ref: @chat.ref), method: :post, class: "raa-button" %>
  </div>
<% end %>
