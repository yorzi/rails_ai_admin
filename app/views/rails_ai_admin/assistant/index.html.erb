<% admin_title t("rails_ai_admin.layout.assistant") %>
<h1><%= t("rails_ai_admin.layout.assistant") %></h1>
<p><%= t("rails_ai_admin.assistant.intro") %></p>
<%= button_to t("rails_ai_admin.assistant.new"), assistant_conversations_path, method: :post, class: "raa-button" %>
<% if @chats.empty? %>
  <p><%= t("rails_ai_admin.assistant.none") %></p>
<% else %>
  <ul class="raa-chat-list">
    <% @chats.each do |chat| %>
      <li><%= link_to t("rails_ai_admin.assistant.from", time: l(chat.created_at.in_time_zone(@context.time_zone), format: :short)), assistant_conversation_path(chat_ref: chat.ref) %>
        <% if chat.status == "archived" %> — <%= t("rails_ai_admin.assistant.archived_mark") %><% elsif !chat.current_for?(@context) %> — <%= t("rails_ai_admin.assistant.closed_mark") %><% end %></li>
    <% end %>
  </ul>
<% end %>
