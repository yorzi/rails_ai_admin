<h1>Overview</h1>
<p>Select a resource to manage. Available resources follow your current permissions.</p>
<ul class="raa-cards">
  <% resource_navigation.each do |group| %>
    <% group.entries.each do |entry| %>
      <li><%= link_to resources_path(resource: entry.key) do %><%= navigation_icon(entry.icon) %><%= entry.label %><% end %></li>
    <% end %>
  <% end %>
</ul>
<% if resource_navigation.empty? %><p>No resources are available for this session.</p><% end %>
