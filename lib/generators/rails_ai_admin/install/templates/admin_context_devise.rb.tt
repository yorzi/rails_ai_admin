# Who may use the admin. Written for Devise's :<%= @auth.scope %> scope.
class AdminContext
  # One fixed tenant for an app without accounts. With an Account model, pass
  # the user's account instead and scope the policy by it.
  SingleTenant = Data.define(:id)
  TENANT = SingleTenant.new(id: "app")

  def resolve(controller)
    # Warden is the Rack authentication boundary behind Devise's helpers.
    context_for(controller.request.env["warden"]&.authenticate(scope: :<%= @auth.scope %>))
  end

  # Background work (bulk operations, the assistant) rebuilds the same
  # authority from the stored reference.
  def resolve_job(actor_ref:, tenant_ref:, security_version:)
    prefix = "raa:actor:<%= @auth.model %>:"
    return unless actor_ref.start_with?(prefix)
    context = context_for(<%= @auth.model %>.find_by(id: actor_ref.delete_prefix(prefix)))
    context if context&.tenant_ref == tenant_ref
  end

  private

  def context_for(user)
    return unless user && admin?(user)
    return if user.respond_to?(:active_for_authentication?) && !user.active_for_authentication?
    # Any change to the user, including the admin flag, closes open forms.
    RailsAiAdmin::Context.new(actor: user, tenant: TENANT, security_version: user.updated_at.utc.iso8601(6))
  end

<% if @auth.all_admins -%>
  # Every signed-in <%= @auth.model %> may use the admin. Narrow it here if
  # only some of them should.
  def admin?(user)
    true
  end
<% else -%>
  # Decide who may use the admin. It stays closed until this returns true for
  # someone. The usual way is a boolean column:
  #   bin/rails generate migration AddAdminTo<%= @auth.model.pluralize %> admin:boolean
  def admin?(user)
    user.respond_to?(:admin?) && user.admin?
  end
<% end -%>
end
