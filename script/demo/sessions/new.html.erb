<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · Rails AI Admin demo</title>
  <style nonce="<%= content_security_policy_nonce if respond_to?(:content_security_policy_nonce) %>">
    body { font: 16px/1.5 system-ui, sans-serif; margin: 0; background: #f6f8fa; color: #172b3a; }
    main { max-width: 34rem; margin: 3rem auto; padding: 0 1rem; }
    .card { background: #fff; border: 1px solid #c7d3dc; border-radius: .6rem; padding: 1.5rem; margin-bottom: 1.25rem; }
    h1 { margin-top: 0; font-size: 1.6rem; }
    label { display: block; font-weight: 600; margin-top: .75rem; }
    input[type=email], input[type=password] { width: 100%; box-sizing: border-box; padding: .55rem .7rem; font: inherit; border: 1px solid #c7d3dc; border-radius: .4rem; }
    button { margin-top: 1rem; padding: .55rem 1rem; font: inherit; font-weight: 600; color: #fff; background: #155e75; border: 0; border-radius: .4rem; cursor: pointer; }
    .accounts form { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .6rem 0; border-top: 1px solid #e3eaf0; }
    .accounts form:first-of-type { border-top: 0; }
    .accounts button { margin: 0; white-space: nowrap; }
    .muted { color: #506776; font-size: .9rem; }
    .error { color: #ad2530; font-weight: 600; }
  </style>
</head>
<body>
<main>
  <h1>Rails AI Admin demo</h1>
  <p class="muted">A local demo with sample data. Every account uses the password <code>demo-password</code>.</p>
  <% if @error %><p class="error" role="alert"><%= @error %></p><% end %>
  <section class="card accounts" aria-labelledby="accounts">
    <h2 id="accounts">Sign in with one click</h2>
    <% [ [ "admin@example.test", "Admin", "Everything in Tenant A: edits, imports, exports, history, audit log, AI chat and MCP access" ],
         [ "viewer@example.test", "Viewer", "Tenant A, read-only" ],
         [ "other@example.test", "Other tenant", "Tenant B, which has almost no data" ] ].each do |email, label, note| %>
      <%= form_with url: "/login", local: true do |form| %>
        <div><strong><%= label %></strong> <span class="muted"><%= email %></span><br><span class="muted"><%= note %></span></div>
        <%= hidden_field_tag :email, email, id: nil %>
        <%= hidden_field_tag :password, "demo-password", id: nil %>
        <button type="submit">Sign in as <%= label %></button>
      <% end %>
    <% end %>
  </section>
  <section class="card" aria-labelledby="manual">
    <h2 id="manual">Or type them</h2>
    <%= form_with url: "/login", local: true do |form| %>
      <%= form.label :email, "Email" %>
      <%= form.email_field :email, value: params[:email].presence || "admin@example.test", autocomplete: "username" %>
      <%= form.label :password, "Password" %>
      <%= form.password_field :password, value: "demo-password", autocomplete: "current-password" %>
      <button type="submit">Sign in</button>
    <% end %>
  </section>
</main>
</body>
</html>
