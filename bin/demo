#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs one seeded session/SQLite demo on loopback. Chat works offline by
# default; --openrouter swaps only the model provider. Each port gets its own
# disposable host directory.

require "bundler"
require "fileutils"
require "optparse"
require "rbconfig"

DEFAULT_PORT = 3917

options = { port: DEFAULT_PORT, openrouter: false, serve: true }
OptionParser.new do |parser|
  parser.banner = "Usage: bin/demo [--openrouter] [--port PORT] [--setup-only]"
  parser.separator "Runs the full demo with an offline assistant by default."
  parser.on("--openrouter", "Use real models instead (requires OPENROUTER_API_KEY for Chat)") { options[:openrouter] = true }
  parser.on("--port PORT", Integer, "Port on 127.0.0.1 (default 3917; offline provider uses the next port)") { |port| options[:port] = port }
  parser.on("--setup-only", "Prepare and seed the demo without serving") { options[:serve] = false }
  parser.on("--assistant", "Legacy alias for the default") { }
end.parse!
abort "bin/demo: choose a port from 1024 to 65534" unless options[:port].between?(1024, 65_534)
abort "bin/demo: unexpected argument #{ARGV.first.inspect}" unless ARGV.empty?

ROOT = File.expand_path("..", __dir__)
ASSETS = File.join(ROOT, "script/demo")
TARGET = File.join(ROOT, "tmp", options[:port] == DEFAULT_PORT ? "demo" : "demo-#{options[:port]}")
DISPLAY_TARGET = TARGET.delete_prefix("#{ROOT}/")
ENV_VARS = { "BUNDLE_GEMFILE" => File.join(TARGET, "Gemfile"), "BUNDLE_PATH" => File.join(ROOT, "vendor/bundle"),
  # An inherited DATABASE_URL would override the demo's disposable SQLite database.
  "BUNDLE_APP_CONFIG" => File.join(TARGET, ".bundle"), "RAILS_ENV" => "development", "DATABASE_URL" => nil,
  "RAA_DEMO_PROVIDER" => options[:openrouter] ? "openrouter" : "offline", "RAA_DEMO_PORT" => options[:port].to_s }.freeze
BUNDLE = [ RbConfig.ruby, "-S", "bundle" ].freeze

def step(message) = puts("==> #{message}")

def run(*command)
  Bundler.with_unbundled_env { system(ENV_VARS, *BUNDLE, *command, chdir: TARGET, out: File::NULL) }
end

def run!(*command)
  abort "bin/demo: failed: bundle #{command.join(' ')} (rerun it inside #{DISPLAY_TARGET} to see the output)" unless run(*command)
end

def edit(path, before, after)
  file = File.join(TARGET, path)
  source = File.read(file)
  abort "bin/demo: #{path} changed; update bin/demo" unless source.include?(before)
  File.write(file, source.sub(before, after))
end

step "Copying the session/SQLite host to #{DISPLAY_TARGET}"
FileUtils.rm_rf(TARGET)
FileUtils.mkdir_p(File.dirname(TARGET))
FileUtils.cp_r(File.join(ROOT, "spec_hosts/session_sqlite"), TARGET)
FileUtils.mkdir_p(%w[storage log].map { |dir| File.join(TARGET, dir) })
# The packaged host pins the exact release version; the demo runs this checkout.
require_relative "../lib/rails_ai_admin/version"
edit("Gemfile", %(gem "rails_ai_admin", "#{RailsAiAdmin::VERSION}"), %(gem "rails_ai_admin", path: #{ROOT.inspect}))
FileUtils.cp(File.join(ASSETS, "seeds.rb"), File.join(TARGET, "db/seeds.rb"))
# One-click sign-in for the tour, plus two accounts for comparing permissions.
FileUtils.cp(File.join(ASSETS, "sessions/new.html.erb"), File.join(TARGET, "app/views/sessions/new.html.erb"))
edit("app/controllers/sessions_controller.rb", %(render plain: "Invalid credentials", status: :unauthorized),
  %(@error = "Could not sign in. Choose a demo account to try again."\n      render :new, status: :unauthorized))

# The header shows who is signed in and a sign-out button.
edit("app/controllers/sessions_controller.rb", "  def new; end\n", <<~RUBY.gsub(/^/, "  "))
  def new; end

  def destroy
    reset_session
    redirect_to "/login", status: :see_other
  end
RUBY
edit("config/routes.rb", %(  post "/login", to: "sessions#create"\n), %(  post "/login", to: "sessions#create"\n  delete "/logout", to: "sessions#destroy"\n))

showcase = File.join(ASSETS, "showcase")
edit("config/application.rb", %(require "active_job/railtie"\n), %(require "active_job/railtie"\nrequire "active_storage/engine"\nrequire "action_text/engine"\n))
edit("config/application.rb", "    config.log_level = :info\n", <<~RUBY.gsub(/^/, "    "))
  config.log_level = :info
  config.active_job.queue_adapter = :async
  config.active_storage.service = :local
  config.active_storage.variant_processor = :disabled
RUBY
File.write(File.join(TARGET, "config/storage.yml"), "local:\n  service: Disk\n  root: <%= Rails.root.join(\"storage\") %>\n")
FileUtils.cp(File.join(showcase, "migration.rb"), File.join(TARGET, "db/migrate/20261113000001_create_showcase.rb"))
FileUtils.cp(File.join(showcase, "articles-import.csv"), TARGET)
Dir[File.join(showcase, "models/*.rb")].each { |path| FileUtils.cp(path, File.join(TARGET, "app/models")) }
Dir[File.join(showcase, "rails_ai_admin/*.rb")].each { |path| FileUtils.cp(path, File.join(TARGET, "app/rails_ai_admin")) }
File.write(File.join(TARGET, "db/seeds.rb"), File.read(File.join(showcase, "seeds.rb")), mode: "a")
edit("app/rails_ai_admin/admin_policy_adapter.rb", "class AdminPolicyAdapter < RailsAiAdmin::Authorization::Adapter\n",
  "class AdminPolicyAdapter < RailsAiAdmin::Authorization::Adapter\n  prepend ShowcasePolicy\n")
edit("app/rails_ai_admin/order_admin.rb", "  operation :review_order", <<~RUBY.gsub(/^/, "  ") + "  operation :review_order")
  dashboard do
    metric :drafts, scope: :drafts, label: "Orders waiting for review"
    metric :expedited, scope: :expedited, label: "Expedited orders"
    trend :delivery_on, days: 30, label: "Deliveries"
  end
RUBY

# Follow the gem's supported range, so the demo resolves the RubyLLM the
# checkout was tested with instead of an older pinned release.
File.write(File.join(TARGET, "Gemfile"), %(gem "ruby_llm", ">= 2.2.0", "< 3"\ngem "rails_tool_views", "1.0.2"\n), mode: "a")
# rails_tool_views controllers inherit the host's ApplicationController.
File.write(File.join(TARGET, "app/controllers/application_controller.rb"), "class ApplicationController < ActionController::Base\nend\n")
FileUtils.cp(File.join(ASSETS, "admin_assistant.rb"), File.join(TARGET, "app/rails_ai_admin"))
edit("app/rails_ai_admin/customer_admin.rb", %(operation :award_points, handler: "AwardCustomerPoints"),
  %(operation :award_points, handler: "AwardCustomerPoints", surface: true, assistant: true\n  assistant_changes :update, :bulk_update))
edit("app/rails_ai_admin/customer_admin.rb", %(integer :points, tab: "Account", panel: "Rewards"),
  %(integer :points, aggregatable: true, tab: "Account", panel: "Rewards"))
edit("app/rails_ai_admin/order_admin.rb", %(decimal :total, required: true, nullable: false, filterable: true,),
  %(decimal :total, required: true, nullable: false, filterable: true, aggregatable: true,))
FileUtils.cp(File.join(ASSETS, "demo_config.rb"), File.join(TARGET, "config/initializers/rails_ai_admin.rb"))

step "Installing gems (prefers those already installed)"
FileUtils.rm_f(File.join(TARGET, "Gemfile.lock"))
run!("install", "--prefer-local") unless run("install", "--local", "--quiet")
step "Running the install generators"
run!("exec", "rails", "generate", "rails_ai_admin:install", "--skip")
run!("exec", "rails", "generate", "rails_tool_views:install", "--skip")
run!("exec", "rails", "generate", "rails_ai_admin:assistant", "--skip")
run!("exec", "rails", "railties:install:migrations", "FROM=active_storage,action_text")
step "Migrating and seeding a fresh database"
run!("exec", "rails", "db:migrate", "db:seed")

admin = "http://127.0.0.1:#{options[:port]}/staff"
puts <<~TEXT

  Demo ready in #{DISPLAY_TARGET}.
    Start:     http://127.0.0.1:#{options[:port]}/login → Sign in as Admin
    Tour:      Overview → Articles → Assistant → Audit log
    CSV:       #{DISPLAY_TARGET}/articles-import.csv
    Chat:      #{admin}/assistant → New conversation
TEXT
if options[:openrouter]
  puts "    Model:     #{ENV.fetch('RAA_DEMO_MODEL', 'openai/gpt-6-luna')} through OpenRouter; set OPENROUTER_API_KEY before starting"
else
  puts '    Try:       "sum orders total by state", then "set articles 1 title to Hello" (offline, no key)'
end
exit unless options[:serve]

pids = []
stop = lambda do
  pids.each do |pid|
    Process.kill("TERM", pid)
  rescue Errno::ESRCH
    nil
  end
  pids.each do |pid|
    Process.wait(pid)
  rescue Errno::ECHILD
    nil
  end
end
%w[INT TERM].each { |signal| trap(signal) { stop.call; exit } }
begin
  Bundler.with_unbundled_env do
    unless options[:openrouter]
      pids << Process.spawn(ENV_VARS, *BUNDLE, "exec", "puma", "--quiet", "-b", "tcp://127.0.0.1:#{options[:port] + 1}",
        File.join(ASSETS, "fake_llm.ru"), chdir: TARGET, out: File.join(TARGET, "log/fake_llm.log"), err: [ :child, :out ])
    end
    pids << Process.spawn(ENV_VARS, *BUNDLE, "exec", "puma", "-b", "tcp://127.0.0.1:#{options[:port]}", "config.ru", chdir: TARGET)
  end
  puts "\nServing on 127.0.0.1 only. Press Ctrl-C to stop."
  # Either server exiting ends the demo instead of leaving a half-working host.
  Process.wait2(-1).last.then { |status| exit(status.exitstatus || 1) }
ensure
  stop.call
end
